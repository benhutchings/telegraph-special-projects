---
import Base from '../layouts/Base.astro';
import ProjectBrowser from '../components/ProjectBrowser.astro';
import { getProjects } from '../lib/projects';

const projects = getProjects();
---

<Base noHeader>
  <div class="wrap wrap--wide browse">
    <ProjectBrowser projects={projects} />
  </div>
</Base>

<style>
  .browse { padding-top: 32px; margin-bottom: 64px; }
</style>
