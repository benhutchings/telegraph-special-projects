---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Button from '../components/Button.astro';
import { getProjects, getTypes } from '../lib/projects';

const PER_SECTION = 3;
const projects = getProjects();
const sections = getTypes().map((t) => ({
  ...t,
  items: projects.filter((p) => p.typeSlug === t.slug).slice(0, PER_SECTION),
}));
---

<Base>
  <section class="hero">
    <h1 class="hero-title">Special Projects</h1>
  </section>

  {sections.map((s) => (
    <section class="wrap section" aria-labelledby={`s-${s.slug}`}>
      <div class="section-head">
        <h2 id={`s-${s.slug}`}><a href={`/type/${s.slug}/`}>{s.name}</a></h2>
        {s.description && <p>{s.description}</p>}
      </div>
      <div class="grid">
        {s.items.map((p) => <ProjectCard project={p} />)}
      </div>
      <div class="more">
        <Button href={`/type/${s.slug}/`}>
          See {s.count > PER_SECTION ? `all ${s.count}` : 'more'}<span class="visually-hidden"> {s.name} projects</span>
        </Button>
      </div>
    </section>
  ))}
</Base>

<style>
  /* Styled after the Telegraph "Brain health games" page header (.bhg-home__header):
     full-width black band, soft white glow rising from the bottom, and a 1px white
     rule that fades out towards both edges. */
  .hero {
    position: relative;
    padding: 0 var(--gutter) 16px; /* 32px gap above comes from the site header */
    background-color: var(--bg);
    background-image: radial-gradient(ellipse 52% 100% at 50% 100%, rgba(255, 255, 255, 0.3), transparent);
    background-repeat: no-repeat;
    text-align: center;
  }
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to left, transparent, #fff, transparent);
    pointer-events: none;
  }
  /* Austin News Ionic Semibold headline: 32/35 → 40/40 (375px+) → 70/70 (768px+) */
  .hero-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 32px;
    line-height: 35px;
    color: var(--ink);
  }
  @media (min-width: 375px) {
    .hero { padding-bottom: 24px; }
    .hero-title { font-size: 40px; line-height: 40px; }
  }
  @media (min-width: 480px) {
    .hero { padding-bottom: 32px; }
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 70px; line-height: 70px; }
  }
  /* The hero's fading rule replaces the first section's top border */
  .hero + .section .section-head { border-top: 0; }
  .section { margin-top: 24px; }
  .hero + .section { margin-top: 40px; }
  .more {
    display: flex;
    justify-content: flex-end;
    margin: 36px 0 32px;
  }
</style>
