---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Button from '../../components/Button.astro';
import { getProjects, getTypes } from '../../lib/projects';

export function getStaticPaths() {
  return getTypes().map((t) => ({ params: { type: t.slug }, props: { type: t } }));
}

const { type } = Astro.props;
const projects = getProjects().filter((p) => p.typeSlug === type.slug);
---

<Base title={type.name} description={type.description || `${type.name} projects from The Telegraph's special projects team.`}>
  <section class="wrap">
    <h1 class="page-title">{type.name}</h1>
    <div class="section-head">
      <h2>{type.count} {type.count === 1 ? 'project' : 'projects'}</h2>
      {type.description && <p>{type.description}</p>}
    </div>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <div class="back">
      <Button href="/" icon="left">Back to all formats</Button>
    </div>
  </section>
</Base>

<style>
  .page-title { margin: clamp(32px, 6vw, 72px) 0 clamp(40px, 6vw, 72px); }
  .back { margin-top: 56px; }
</style>
