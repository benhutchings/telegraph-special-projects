---
import Base from '../layouts/Base.astro';
import BrowseShell from '../components/BrowseShell.astro';
import { getProjects, getTypes } from '../lib/projects';

const projects = getProjects();
const types = getTypes();
---

<Base title="About" noHeader>
  <div class="wrap wrap--wide page">
    <BrowseShell about>
      <article>
        <!-- Kept for screen readers and the document outline; not shown -->
        <h1 class="visually-hidden">About</h1>
        <div class="prose">
          <!-- Replace this copy with the team's own description. -->
          <p>
            The Telegraph's special projects team works with reporters, editors, designers and
            developers to tell stories in formats that go beyond the standard article: interactive
            graphics, data-led investigations, immersive scrollytelling, games and more.
          </p>
          <p>
            This site is an archive of that work. It currently holds {projects.length} projects across {types.length} formats. Each entry links to the published piece and, where available, the
            original Figma design file.
          </p>
        </div>
      </article>
    </BrowseShell>
  </div>
</Base>

<style>
  .page { padding-top: 32px; margin-bottom: 64px; }
  /* type.body.doric.body-2: Doric UI Regular 15/21 */
  .prose { max-width: 38em; }
  .prose p {
    margin: 0 0 1em;
    font-size: 15px;
    line-height: 21px;
    color: var(--ink-2);
  }
</style>
