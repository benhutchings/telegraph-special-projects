---
import '../styles/global.css';
import Header from '../components/Header.astro';
// The sidebar's fonts, preloaded so they arrive with the page instead of after the
// CSS is read. Without this, each page briefly draws the sidebar in the fallback
// font and the text shifts when Doric loads.
import doricRegular from '../assets/fonts/DoricNewsUI-UIRegular.woff2?url';
import doricMedium from '../assets/fonts/DoricNewsUI-HedMedium.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Leave out the site header (pages that carry their own masthead). */
  noHeader?: boolean;
}

const SITE = 'Telegraph Special Projects';
const { title, description = 'An archive of special projects from The Telegraph.', image, noHeader = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : SITE;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={doricRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={doricMedium} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!noHeader && <Header />}
    <main id="main">
      <slot />
    </main>
  </body>
</html>
