---
// Page frame shared by the home, project and About pages: masthead, search and
// format/year sidebar on the left, page content on the right (<slot />).
// Below 860px the sidebar becomes a slide-in drawer opened from the "Browse" bar.
//
// The sidebar is plain links and a GET form, so on any page it takes you to the
// home page with that filter applied (/?type=…, /?year=…, /?q=…). On the home
// page, ProjectBrowser intercepts them and filters the grid in place instead.
import { getProjects, getTypes } from '../lib/projects';
import TelegraphT from '../assets/telegraph-t.svg';

interface Props {
  /** Format and year to mark as current in the sidebar. */
  type?: string;
  year?: string;
  /** Use an h1 for the site title (pages whose own heading isn't the h1). */
  brandIsHeading?: boolean;
  /** Mark the About link as the current page. */
  about?: boolean;
}
const { type = '', year = '', brandIsHeading = false, about = false } = Astro.props;

const projects = getProjects();
const types = getTypes();

// One marker colour per format, in sidebar order.
const accents = ['#f7b955', '#e9a0f0', '#7cc8f8', '#7ddc9a', '#f08a8a', '#b9a6ff', '#9ad8d0', '#c9c9c9'];
const typeInfo = types.map((t, i) => ({ ...t, accent: accents[i % accents.length] }));

// Years in the order they first appear (the sheet runs newest first).
const years = [...new Set(projects.map((p) => p.year).filter(Boolean))].map((y) => ({
  value: y,
  label: y.replace('/', '–'),
  count: projects.filter((p) => p.year === y).length,
}));

const Brand = brandIsHeading ? 'h1' : 'p';
const current = (on: boolean) => (on ? 'true' : undefined);
---

<div class="browser" data-browser>
  <button class="drawer-scrim" type="button" tabindex="-1" aria-hidden="true" data-close></button>

  <aside class="sidebar" id="browse-panel" aria-label="Browse projects" data-panel>
    <div class="brand-wrap brand-wrap--side">
      <a class="brand" href="/" aria-label="The Telegraph Special Projects – home">
        <TelegraphT class="brand-logo" aria-hidden="true" />
        <Brand class="brand-title">Special Projects</Brand>
      </a>
    </div>
    <div class="panel-head">
      <p class="panel-title">Browse</p>
      <button class="btn btn--icon close" type="button" aria-label="Close" data-close>
        <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" />
        </svg>
      </button>
    </div>

    <form class="search" action="/" method="get" role="search" data-search-form>
      <svg class="search-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="9" cy="9" r="6" /><path d="M13.5 13.5L17 17" stroke-linecap="round" />
      </svg>
      <label class="visually-hidden" for="browse-search">Search projects</label>
      <input id="browse-search" type="search" name="q" placeholder="Search" autocomplete="off" spellcheck="false" data-search />
      <kbd class="kbd" aria-hidden="true" data-kbd>⌘K</kbd>
    </form>

    <nav class="group" aria-label="Formats">
      <ul>
        <li>
          <a class="item" href="/" data-type="" aria-current={current(!type && !year && !about)}>
            <svg class="icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="3" width="5.5" height="5.5" rx="1" /><rect x="11.5" y="3" width="5.5" height="5.5" rx="1" />
              <rect x="3" y="11.5" width="5.5" height="5.5" rx="1" /><rect x="11.5" y="11.5" width="5.5" height="5.5" rx="1" />
            </svg>
            <span class="label">All projects</span>
            <span class="count" data-count>{projects.length}</span>
          </a>
        </li>
      </ul>
      <p class="group-title">
        <svg class="icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 5h12M4 10h12M4 15h7" stroke-linecap="round" />
        </svg>
        Formats
      </p>
      <ul>
        {typeInfo.map((t) => (
          <li>
            <a class="item sub" href={`/?type=${t.slug}`} data-type={t.slug} data-name={t.name} aria-current={current(type === t.slug)}>
              <span class="dot" style={`--accent:${t.accent}`} aria-hidden="true"></span>
              <span class="label">{t.name}</span>
              <span class="count" data-count>{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {years.length > 1 && (
      <nav class="group" aria-labelledby="browse-years">
        <p class="group-title" id="browse-years">
          <svg class="icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="4.5" width="14" height="12.5" rx="2" /><path d="M3 8.5h14M7 3v3M13 3v3" stroke-linecap="round" />
          </svg>
          Year
        </p>
        <ul>
          <li>
            <a class="item sub year" href="/" data-year="" aria-current={current(!type && !year && !about)}>
              <span class="label">Any year</span>
            </a>
          </li>
          {years.map((y) => (
            <li>
              <a class="item sub year" href={`/?year=${encodeURIComponent(y.value)}`} data-year={y.value} aria-current={current(year === y.value)}>
                <span class="label">{y.label}</span>
                <span class="count" data-count>{y.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <nav class="group" aria-label="Site">
      <ul>
        <li>
          <a class="item" href="/about/" aria-current={about ? 'page' : undefined}>
            <svg class="icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="10" cy="10" r="7" /><path d="M10 9v4.5" stroke-linecap="round" /><circle cx="10" cy="6.5" r="0.4" fill="currentColor" />
            </svg>
            <span class="label">About</span>
          </a>
        </li>
      </ul>
    </nav>
  </aside>

  <div class="main-col">
    <div class="brand-wrap brand-wrap--top">
      <a class="brand" href="/" aria-label="The Telegraph Special Projects – home">
        <TelegraphT class="brand-logo" aria-hidden="true" />
        <Brand class="brand-title">Special Projects</Brand>
      </a>
    </div>
    <div class="mobile-bar">
      <button class="btn btn--icon-left browse-btn" type="button" aria-controls="browse-panel" aria-expanded="false" data-open>
        <span class="btn__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 6h12M6.5 10h7M9 14h2" stroke-linecap="round" />
          </svg>
        </span>
        Browse &amp; search
      </button>
    </div>
    <slot />
  </div>
</div>

<script>
  // Drawer and keyboard shortcuts. ProjectBrowser can close the drawer by
  // dispatching a "browse:close" event on [data-browser].
  const root = document.querySelector<HTMLElement>('[data-browser]')!;
  const panel = root.querySelector<HTMLElement>('[data-panel]')!;
  const input = root.querySelector<HTMLInputElement>('[data-search]')!;
  const openBtn = root.querySelector<HTMLButtonElement>('[data-open]')!;
  const narrow = window.matchMedia('(max-width: 860px)');

  if (!/Mac|iPhone|iPad/.test(navigator.platform)) root.querySelector('[data-kbd]')!.textContent = 'Ctrl K';

  // Keep the closed drawer out of the tab order on small screens
  const syncInert = () => { panel.inert = narrow.matches && !root.classList.contains('is-open'); };
  function setOpen(open: boolean) {
    root.classList.toggle('is-open', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('drawer-lock', open);
    syncInert();
    if (open) input.focus({ preventScroll: true });
    else if (narrow.matches) openBtn.focus({ preventScroll: true });
  }

  narrow.addEventListener('change', () => setOpen(false));
  openBtn.addEventListener('click', () => setOpen(true));
  for (const el of root.querySelectorAll('[data-close]')) el.addEventListener('click', () => setOpen(false));
  root.addEventListener('browse:close', () => { if (root.classList.contains('is-open')) setOpen(false); });
  syncInert();

  document.addEventListener('keydown', (e) => {
    const typing = (e.target as Element).closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      if (narrow.matches) setOpen(true);
      input.focus();
      input.select();
    } else if (e.key === 'Escape' && root.classList.contains('is-open')) {
      setOpen(false);
    }
  });
</script>

<style>
  .browser {
    --sidebar-w: 248px;
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  /* ── Sidebar ── */
  .sidebar {
    position: sticky;
    /* Matches the 32px space above the browser on the page, so the sidebar
       is already in its pinned position and never shifts when you scroll */
    top: 32px;
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-bottom: 24px;
  }
  .panel-head { display: none; }

  /* Masthead (Figma "Special Projects website" › Frame 2): Telegraph "T" mark
     beside the site title, Doric News UI medium. Figma sizes scaled up 1.5×. */
  .brand-wrap { padding: 4px 10px 24px; }
  .brand-wrap--top { display: none; }
  .brand {
    display: inline-flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand :global(.brand-logo) {
    display: block;
    flex-shrink: 0;
    width: 18px;
    height: 19.5px;
  }
  .brand-title {
    margin: 0;
    font-family: var(--sans);
    font-weight: 500; /* Figma 525 → Doric Hed Medium */
    font-size: 22.5px;
    line-height: 22.5px;
  }
  .sidebar ul { list-style: none; margin: 0; padding: 0; }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0 0 20px;
  }
  .search-icon {
    position: absolute;
    left: 12px;
    color: var(--ink-3);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    height: 40px;
    padding: 0 56px 0 38px;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 10px;
    -webkit-appearance: none;
    appearance: none;
  }
  .search input::placeholder { color: var(--ink-3); }
  .search input:focus { outline: none; border-color: var(--ink-3); }
  .search input::-webkit-search-cancel-button { display: none; }
  .kbd {
    position: absolute;
    right: 8px;
    padding: 3px 6px;
    font: inherit;
    font-size: 12px;
    line-height: 1;
    color: var(--ink-3);
    border: 1px solid var(--rule);
    border-radius: 6px;
    pointer-events: none;
  }
  .search input:focus ~ .kbd,
  .search input:not(:placeholder-shown) ~ .kbd { display: none; }

  /* Divider between the Formats, Year and About sections */
  .group + .group {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }
  .group + .group > .group-title:first-child { margin-top: 0; }
  .group-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 4px;
    padding: 0 10px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 38px;
    padding: 6px 10px;
    font-size: 15px;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .item:hover { background: #1a1a1a; }
  .item[aria-current='true'],
  .item[aria-current='page'] { background: #262626; }
  .item:focus-visible { outline: 2px solid var(--btn-focus-border); outline-offset: -2px; }
  .item.is-zero:not([aria-current='true']) { color: var(--ink-3); }
  .icon { flex-shrink: 0; color: var(--ink-2); }
  .item[aria-current='true'] .icon,
  .item[aria-current='page'] .icon { color: var(--ink); }
  .label { flex: 1; min-width: 0; }
  .count {
    font-size: 13px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  /* Format markers: small dots, one colour per format */
  .dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin: 0 4px;
    border-radius: 50%;
    background: var(--accent);
  }
  .item.is-zero:not([aria-current='true']) .dot { opacity: 0.4; }
  .year .label { padding-left: 30px; }

  /* ── Content column ── */
  /* Grids in the content column size to the space beside the sidebar, not the window */
  .main-col { container-type: inline-size; min-width: 0; }
  .main-col :global(.grid) { grid-template-columns: 1fr; }
  @container (min-width: 440px) { .main-col :global(.grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container (min-width: 760px) { .main-col :global(.grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .mobile-bar { display: none; }

  .drawer-scrim { display: none; }

  /* ── Narrow screens: sidebar becomes a drawer ── */
  @media (max-width: 860px) {
    .browser { display: block; }
    .brand-wrap--side { display: none; }
    .brand-wrap--top { display: block; padding: 24px 0 8px; }
    .mobile-bar {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      padding: 12px 0;
      margin-bottom: 8px;
      background: var(--bg);
    }
    .browse-btn { width: 100%; height: 40px; border-radius: 10px; justify-content: flex-start; }

    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 40;
      width: min(320px, 86vw);
      max-height: none;
      padding: 16px 12px 32px;
      background: #111;
      border-right: 1px solid var(--rule);
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform 0.25s ease, visibility 0s linear 0.25s;
    }
    .is-open .sidebar {
      transform: none;
      visibility: visible;
      transition: transform 0.25s ease;
    }
    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 16px 10px;
    }
    .panel-title { margin: 0; font-size: 17px; font-weight: 500; }
    .kbd { display: none; }
    .search input { padding-right: 14px; }

    .drawer-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 39;
      padding: 0;
      border: 0;
      background: rgb(0 0 0 / 0.6);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .is-open .drawer-scrim { opacity: 1; pointer-events: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar, .drawer-scrim { transition: none !important; }
  }

  :global(html.drawer-lock) { overflow: hidden; }
</style>
