---
// Project image, or a typographic tile when no image is available.
// Local images go through Astro's <Image>, which outputs resized WebP files and
// a srcset so each screen downloads only the size it needs.
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  large?: boolean;
}
const { project: p, large = false } = Astro.props;

// Card: 3-up at the 1000px content width, 2-up on tablets, full width on phones.
const sizes = large
  ? '(max-width: 1080px) 100vw, 1000px'
  : '(max-width: 540px) 100vw, (max-width: 860px) 50vw, 330px';
const widths = large ? [640, 1000, 1200] : [360, 540, 720];

// Stable muted colour per type, so each type reads as a family.
const palette = ['#2a3a47', '#4a2a2a', '#2c4034', '#3c3350', '#54431f', '#24414f', '#3a3a3a', '#4d3526'];
let h = 0;
for (const ch of p.typeSlug) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const bg = palette[h % palette.length];
const initials = p.title
  .split(/\s+/)
  .filter((w) => /^[A-Za-z0-9]/.test(w))
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');

const loading = large ? 'eager' : 'lazy';
const local = p.image && typeof p.image === 'object' ? p.image : null;
const remote = typeof p.image === 'string' ? p.image : null;
---

<div class:list={['thumb', { large }]} style={`--tile:${bg}`}>
  {local ? (
    <Image
      src={local}
      alt={p.alt}
      widths={widths.filter((w) => w <= local.width)}
      sizes={sizes}
      loading={loading}
      fetchpriority={large ? 'high' : 'auto'}
    />
  ) : remote ? (
    <img src={remote} alt={p.alt} loading={loading} decoding="async" referrerpolicy="no-referrer" />
  ) : (
    <div class="tile" aria-hidden="true">
      <span class="mono">{initials}</span>
    </div>
  )}
</div>

<style>
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-image);
    isolation: isolate; /* keeps corners clipped while the image scales on hover (Safari) */
    background: var(--tile);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .tile {
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 80% 20%, rgb(255 255 255 / 0.1), transparent 50%),
      var(--tile);
  }
  .mono {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1;
    color: rgb(255 255 255 / 0.85);
  }
  .large .mono { font-size: clamp(80px, 16vw, 180px); }
</style>
