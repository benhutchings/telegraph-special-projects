---
// Type filter + search + full project grid, used on /projects/.
import type { Project } from '../lib/projects';
import { getTypes } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props { projects: Project[] }
const { projects } = Astro.props;
const types = getTypes();
---

<div class="controls">
  <div class="filters" role="group" aria-label="Filter by type">
    <button class="btn" type="button" data-filter="" aria-pressed="true">All <span class="count">{projects.length}</span></button>
    {types.map((t) => (
      <button class="btn" type="button" data-filter={t.slug} aria-pressed="false">{t.name} <span class="count">{t.count}</span></button>
    ))}
  </div>
  <label class="search">
    <span class="visually-hidden">Search projects</span>
    <input type="search" placeholder="Search" data-search autocomplete="off" />
  </label>
</div>

<div class="grid" data-grid>
  {projects.map((p) => (
    <div class="cell" data-type={p.typeSlug} data-text={`${p.title} ${p.type} ${p.description} ${p.year}`.toLowerCase()}>
      <ProjectCard project={p} showType />
    </div>
  ))}
</div>
<p class="empty" data-empty hidden>No projects match.</p>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cells = [...document.querySelectorAll<HTMLElement>('[data-grid] .cell')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let type = new URLSearchParams(location.search).get('type') ?? '';

  function apply() {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const c of cells) {
      const ok = (!type || c.dataset.type === type) && terms.every((t) => c.dataset.text!.includes(t));
      c.hidden = !ok;
      if (ok) shown++;
    }
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === type));
    empty.hidden = shown > 0;
  }

  for (const b of buttons) {
    b.addEventListener('click', () => {
      type = b.dataset.filter ?? '';
      const url = new URL(location.href);
      type ? url.searchParams.set('type', type) : url.searchParams.delete('type');
      history.replaceState(null, '', url);
      apply();
    });
  }
  input.addEventListener('input', apply);
  apply();
</script>

<style>
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 40px;
  }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  /* Buttons: XS Outlined White; the selected filter uses the White variant */
  .filters .count { opacity: 0.6; margin-left: 2px; }
  .filters .btn[aria-pressed='true'] {
    background: var(--btn-white-bg);
    border-color: var(--btn-white-border);
    color: var(--btn-white-text);
  }
  .filters .btn[aria-pressed='true']:focus-visible { border-color: var(--btn-focus-border); }

  .search input {
    font: inherit;
    font-size: 13px;
    width: min(220px, 100%);
    padding: 7px 14px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  .search input:focus { border-color: var(--ink); outline: none; }
  .search input::placeholder { color: var(--ink-3); }

  .cell[hidden] { display: none; }
  .empty { color: var(--ink-3); text-align: center; padding: 48px 0; }
</style>
