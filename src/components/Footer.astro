---
import { getTypes } from '../lib/projects';
const year = new Date().getFullYear();
const types = getTypes();
---

<footer class="site-footer">
  <div class="inner">
    <a class="logo" href="/">Special Projects</a>
    <div class="col">
      <ul class="links">
        <li><a href="/projects/">All projects</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="https://www.telegraph.co.uk/" rel="noopener">telegraph.co.uk</a></li>
      </ul>
      <p class="address">
        The Telegraph<br />
        Special Projects<br />
        London
      </p>
    </div>
    <div class="col">
      <ul class="types">
        {types.map((t) => <li><a href={`/type/${t.slug}/`}>{t.name}</a></li>)}
      </ul>
      <p class="copy">© {year} Telegraph Media Group</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: 120px; padding: 0 var(--gutter) 64px; }
  .inner {
    max-width: 800px;
    margin: 0 auto;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    gap: 32px;
    font-size: 13px;
  }
  .logo {
    font-family: var(--display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1;
    text-decoration: none;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  a { text-decoration: none; }
  .links { font-weight: 500; }
  .address { margin: 28px 0 0; color: var(--ink-2); }
  .types { color: var(--ink-2); }
  .copy { margin: 28px 0 0; color: var(--ink-3); }
  @media (max-width: 640px) { .inner { grid-template-columns: 1fr; } }
</style>
