---
import { getTypes } from '../lib/projects';
import Logo from '../assets/telegraph-logo.svg';
import Burger from '../assets/icons/burger.svg';
const types = getTypes();
---

<header class="site-header">
  <div class="wrap bar">
    <a class="masthead" href="/" aria-label="The Telegraph – Special Projects home"><Logo class="logo" aria-hidden="true" /></a>
    <button class="btn btn--icon menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <span class="btn__icon" aria-hidden="true"><Burger /></span>
    </button>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label="Site menu">
  <div class="wrap menu-inner">
    <div class="menu-bar">
      <a class="masthead" href="/" aria-label="The Telegraph – Special Projects home"><Logo class="logo" aria-hidden="true" /></a>
      <button class="btn btn--icon menu-btn" type="button" aria-label="Close menu" data-menu-close>
        <svg width="20" height="20" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" />
        </svg>
      </button>
    </div>
    <nav aria-label="Main">
      <ul class="primary">
        <li><a href="/">Home</a></li>
        <li><a href="/projects/">All projects</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
      <p class="label">Formats</p>
      <ul class="secondary">
        {types.map((t) => <li><a href={`/type/${t.slug}/`}>{t.name}</a></li>)}
      </ul>
    </nav>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  openBtn.addEventListener('click', () => {
    dialog.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
  });
  dialog.querySelector('[data-menu-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => openBtn.setAttribute('aria-expanded', 'false'));
</script>

<style>
  /* Logo sits 32px from the top with 32px below it (the home page title starts there).
     The logo is 89:15, so its height follows its width. */
  .site-header, .menu-bar {
    --logo-w: clamp(150px, 16vw, 190px);
    --logo-h: calc(var(--logo-w) * 15 / 89);
  }
  .bar, .menu-bar {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 32px;
    padding-bottom: 32px;
  }
  .masthead {
    display: block;
    color: var(--ink);
    line-height: 0;
  }
  .masthead :global(.logo) {
    display: block;
    width: var(--logo-w);
    height: var(--logo-h);
  }
  /* Look comes from the shared .btn / .btn--icon styles; this only positions it,
     vertically centred on the logo */
  .menu-btn {
    position: absolute;
    right: var(--gutter);
    top: calc(32px + (var(--logo-h) - 32px) / 2);
  }

  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--ink);
  }
  .menu::backdrop { background: var(--bg); }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu nav { padding: 48px 0; text-align: center; }
  .primary a {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.25;
    text-decoration: none;
  }
  .label {
    margin: 48px 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .secondary a { font-size: 18px; line-height: 1.8; text-decoration: none; }
</style>
